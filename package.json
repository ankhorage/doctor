{
  "name": "@ankhorage/doctor",
  "version": "0.14.7",
  "description": "Executable Ankh provider and standalone CLI for lightweight repo and package compliance diagnostics.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/ankhorage/doctor#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/doctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/doctor.git"
  },
  "keywords": [
    "ankhorage",
    "doctor",
    "cli",
    "compliance",
    "manifest",
    "secret-store",
    "oauth",
    "typescript",
    "bun"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    },
    "./package.json": "./package.json",
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js",
      "default": "./dist/capabilities/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "ankhorage-doctor": "./dist/cli/standalone.js"
  },
  "ankh": {
    "category": "doctor",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "doctor.validate",
        "owner": "@ankhorage/doctor",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "doctor.fix",
        "owner": "@ankhorage/doctor",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "doctor.repo",
        "owner": "@ankhorage/doctor",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      },
      {
        "id": "doctor.package",
        "owner": "@ankhorage/doctor",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "test": "bun test",
    "docs": "bunx @ankhorage/paradox && ankhorage-prettier --write README.md paradox",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip",
    "test:standalone": "bun test tests/standaloneContract.test.ts"
  },
  "dependencies": {
    "@ankhorage/capability": "^0.2.1",
    "@ankhorage/contracts": "^25.0.0",
    "@ankhorage/dependency-graph": "^1.3.0",
    "@ankhorage/rules-architecture": "^0.6.0",
    "@ankhorage/rules-repository": "^0.2.0",
    "@ankhorage/supabase-auth": "^1.2.40",
    "@ankhorage/utility": "^1.9.85"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.12.2",
    "@ankhorage/devtools": "^2.3.9",
    "@ankhorage/paradox": "^0.3.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  },
  "sideEffects": false,
  "packageManager": "bun@1.4.2"
}
